{
    "name": "caw/plugin-builder",
    "description": "WordPress plugin builder powered by Anthropic Managed Agents — describe a plugin, an agent authors and tests it in a hosted sandbox, and a host-side safety gauntlet validates it before it ever touches the live site.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "anthropic-ai/sdk": "^0.24.0",
        "nyholm/psr7": "^1.8",
        "symfony/http-client": "^6.4 || ^7.0"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.7",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CAW\\PluginBuilder\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CAW\\PluginBuilder\\Tests\\": "../tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse"
    }
}
